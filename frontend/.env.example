# Copy to .env.local for local dev. `pnpm dev` boots with none of these set
# (see lib/env.ts's zero-config dev defaults) — only needed to talk to a
# real Cognito pool / backend deployment.

NEXT_PUBLIC_COGNITO_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
# Full hosted-UI domain host, e.g. iam-sentinel-dev-123456.auth.us-east-1.amazoncognito.com
NEXT_PUBLIC_COGNITO_DOMAIN=
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
# Set to "true" to bypass MSW and call a real deployed backend.
NEXT_PUBLIC_USE_LIVE_BACKEND=false

# Server-only — never exposed to the browser bundle.
BACKEND_ORIGIN=http://localhost:8000
SESSION_COOKIE_SECRET=
