{
  "name": "iam-sentinel-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:live": "cross-env NEXT_PUBLIC_USE_LIVE_BACKEND=true playwright test",
    "axe": "playwright test tests/e2e/axe.spec.ts",
    "generate:api-types": "openapi-typescript ../backend/openapi.golden.json -o lib/api-types.gen.ts",
    "check:api-drift": "node scripts/check-api-drift.mjs",
    "msw:init": "msw init public --save"
  },
  "dependencies": {
    "@aws-amplify/ui-react": "6.5.5",
    "@radix-ui/react-dialog": "1.1.2",
    "@radix-ui/react-slot": "1.1.0",
    "@radix-ui/react-tabs": "1.1.1",
    "@radix-ui/react-toast": "1.2.2",
    "@tanstack/react-query": "5.59.16",
    "aws-amplify": "6.6.6",
    "class-variance-authority": "0.7.0",
    "clsx": "2.1.1",
    "framer-motion": "11.11.9",
    "jose": "5.9.6",
    "lucide-react": "0.454.0",
    "next": "14.2.15",
    "next-themes": "0.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.13.0",
    "tailwind-merge": "2.5.4",
    "zod": "3.23.8",
    "zustand": "5.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.1",
    "@playwright/test": "1.48.1",
    "@testing-library/jest-dom": "6.6.2",
    "@testing-library/react": "16.0.1",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "20.16.11",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "@typescript-eslint/eslint-plugin": "8.10.0",
    "@typescript-eslint/parser": "8.10.0",
    "@vitest/coverage-v8": "2.1.3",
    "autoprefixer": "10.4.20",
    "cross-env": "7.0.3",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.15",
    "jsdom": "25.0.1",
    "msw": "2.4.10",
    "openapi-typescript": "7.4.1",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.14",
    "typescript": "5.6.3",
    "vitest": "2.1.3"
  }
}
