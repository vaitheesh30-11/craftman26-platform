{
  "components": {
    "schemas": {
      "ApprovalRequest": {
        "additionalProperties": false,
        "properties": {
          "dry_run": {
            "default": false,
            "title": "Dry Run",
            "type": "boolean"
          },
          "reason": {
            "default": "",
            "maxLength": 2048,
            "title": "Reason",
            "type": "string"
          },
          "remediation_index": {
            "default": 0,
            "minimum": 0.0,
            "title": "Remediation Index",
            "type": "integer"
          }
        },
        "title": "ApprovalRequest",
        "type": "object"
      },
      "ChatRequest": {
        "additionalProperties": false,
        "properties": {
          "hints": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Hints",
            "type": "object"
          },
          "include_arns_in_output": {
            "default": false,
            "title": "Include Arns In Output",
            "type": "boolean"
          },
          "include_streaming": {
            "default": false,
            "title": "Include Streaming",
            "type": "boolean"
          },
          "query_text": {
            "maxLength": 4096,
            "minLength": 1,
            "title": "Query Text",
            "type": "string"
          }
        },
        "required": [
          "query_text"
        ],
        "title": "ChatRequest",
        "type": "object"
      },
      "FastPathRequest": {
        "additionalProperties": false,
        "properties": {
          "payload": {
            "title": "Payload",
            "type": "object"
          }
        },
        "title": "FastPathRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
