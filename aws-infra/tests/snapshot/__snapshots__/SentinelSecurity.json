                "arn:aws:s3:::sentinel-*-dev",
                "arn:aws:s3:::sentinel-*-dev/*",
                "arn:aws:kms:us-east-1:111111111111:key/*",
                "arn:aws:bedrock:us-east-1:111111111111:*",
                "arn:aws:access-analyzer:us-east-1:111111111111:*"
              ],
              "Sid": "AllowWithinSentinelResources"
            },
            {
              "Action": "sts:AssumeRole",
              "Effect": "Allow",
              "Resource": [
                "arn:aws:iam::*:role/SentinelCrossAccountRole",
                "arn:aws:iam::*:role/SentinelDelegatedAdminAccountRole"
              ],
              "Sid": "AllowCrossAccountRoleAssumption"
            },
            {
              "Action": [
                "iam:PutRolePolicy",
                "iam:DeleteRolePolicy"
              ],
              "Effect": "Allow",
              "Resource": "arn:aws:iam::*:role/aws-reserved/sso.amazonaws.com/*",
              "Sid": "AllowF5SessionTerminatorScope"
            },
            {
              "Action": [
                "iam:Create*",
                "iam:Delete*",
                "iam:Attach*Policy*"
              ],
              "Effect": "Deny",
              "NotResource": "arn:aws:iam::*:role/aws-reserved/sso.amazonaws.com/*",
              "Sid": "DenyIamMutationOutsideF5Scope"
            },
            {
              "Action": [
                "organizations:Update*",
                "organizations:Delete*"
              ],
              "Effect": "Deny",
              "Resource": "*",
              "Sid": "DenyOrganizationsWrites"
            },
            {
              "Action": "cloudformation:*",
              "Effect": "Deny",
              "Resource": "*",
              "Sid": "DenySelfMutationViaCloudFormation"
            },
            {
              "Action": [
                "iam:CreatePolicyVersion",
                "iam:DeleteRolePermissionsBoundary",
                "iam:PutRolePermissionsBoundary"
