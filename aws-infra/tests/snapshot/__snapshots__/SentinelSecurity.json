      "Properties": {
        "Description": "Permission boundary for every IAM Sentinel role.",
        "Path": "/",
        "PolicyDocument": {
          "Statement": [
            {
              "Action": [
                "bedrock:*",
                "dynamodb:*",
                "s3:*",
                "kms:*",
                "access-analyzer:*",
                "organizations:Describe*",
                "organizations:List*"
