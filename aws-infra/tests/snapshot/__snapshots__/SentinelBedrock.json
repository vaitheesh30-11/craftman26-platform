              ]
            },
            "KnowledgeBaseState": "ENABLED"
          }
        ],
        "Tags": {
          "Owner": "iam-sentinel@customer.com",
          "Project": "IAMSentinel",
          "Stage": "dev"
        }
      },
      "Type": "AWS::Bedrock::Agent"
    },
