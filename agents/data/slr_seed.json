{
  "autoscaling.amazonaws.com": {
    "slr_name": "AWSServiceRoleForAutoScaling",
    "required_actions": [
      "ec2:DescribeAccountAttributes",
      "ec2:DescribeInstances",
      "ec2:DescribeImages",
      "ec2:DescribeSubnets",
      "ec2:CreateLaunchTemplate",
      "ec2:CreateFleet",
      "ec2:RunInstances",
      "ec2:TerminateInstances",
      "ec2:CreateTags",
      "elasticloadbalancing:RegisterInstancesWithLoadBalancer",
      "elasticloadbalancing:DeregisterInstancesFromLoadBalancer",
      "elasticloadbalancing:RegisterTargets",
      "elasticloadbalancing:DeregisterTargets"
    ],
    "optional_actions": ["cloudwatch:PutMetricAlarm", "sns:Publish"],
    "core_actions": ["ec2:RunInstances", "ec2:TerminateInstances"],
    "source": "AWS Service Authorization Reference",
    "source_url": "https://docs.aws.amazon.com/service-authorization/latest/reference/list_autoscaling.html"
  },
