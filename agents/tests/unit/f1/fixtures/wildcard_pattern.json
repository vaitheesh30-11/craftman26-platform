{
  "description": "Wildcard PassRole Resource pattern must resolve to exactly the 4 matching prod-* roles, not the non-matching staging role.",
  "users": [
    {
      "name": "ReleaseEngineer",
      "inline_policies": [
        {
          "name": "PassRoleWildcardProd",
          "document": {
            "Version": "2012-10-17",
            "Statement": [
              {
                "Sid": "AllowPassAnyProdRole",
                "Effect": "Allow",
                "Action": "iam:PassRole",
                "Resource": "arn:aws:iam::*:role/prod-*"
              }
            ]
          }
        }
      ]
    }
  ],
  "roles": [
    { "name": "prod-web" },
    { "name": "prod-api" },
    { "name": "prod-db" },
    { "name": "prod-worker" },
    { "name": "staging-web" }
  ],
  "expected_edge_count": 1,
  "expected_resolved_role_count": 4,
  "expected_blast_score": "LOW"
}
